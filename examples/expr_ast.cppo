struct CPU {
    u64 x0;
};

fn add(a: int, b: int) -> int {
    return a + b;
}

fn main() -> int {
    let x = 2 + 3 * 4;
    let y = (x + 1) * 2;
    let cpu = CPU();
    cpu.x0 = add(x, y);

    let p = &cpu;
    p->x0 += 5;

    if (p->x0 >= 40 && p->x0 < 50) {
        print("expr ast: {p->x0}");
    } else {
        print("expr ast failed: {p->x0}");
    }

    return 0;
}
