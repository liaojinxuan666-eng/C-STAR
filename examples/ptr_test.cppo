struct CPU {
    u64 pc;
    u64 x0;
}

fn execute(inst: u32, cpu: CPU*) -> int {
    let mem = u8[4];
    mem[0] = 42;
    cpu->x0 = mem[0];
    return 0;
}

fn main() -> int {
    let cpu = CPU();
    cpu.pc = 0;
    cpu.x0 = 0;

    while cpu.pc < 12 {
        let inst = 1;
        execute(inst, &cpu);
        cpu.pc = cpu.pc + 4;
    }
    
    print("Final PC = {cpu.pc}");
    print("Final X0 = {cpu.x0}");
    return 0;
}